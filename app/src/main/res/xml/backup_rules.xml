<?xml version="1.0" encoding="utf-8"?><!--
   Android's own Auto Backup on Android 11 and older. Same exclusions, and same reasons, as
   data_extraction_rules.xml: the database and the DataStore are restored only through the app's Drive backups.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore" />
</full-backup-content>
